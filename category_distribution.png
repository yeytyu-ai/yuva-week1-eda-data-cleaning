import os
import pandas as pd
import matplotlib.pyplot as plt

os.makedirs("plots", exist_ok=True)

# Load the dataset
df = pd.read_csv("data/beauty_wellness.csv")

# Check category column
category_column = "primary_category"

if category_column in df.columns:
    df[category_column].value_counts().head(10).plot(
        kind="bar",
        figsize=(10, 5)
    )

    plt.title("Top 10 Beauty Product Categories")
    plt.xlabel("Category")
    plt.ylabel("Number of Products")
    plt.xticks(rotation=45, ha="right")
    plt.tight_layout()

    plt.savefig("plots/category_distribution.png")
    plt.close()

    print("Category graph generated successfully!")
else:
    print("Category column not found.")
    print("Available columns:", df.columns.tolist())
